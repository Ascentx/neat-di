{
  "name": "neat-di",
  "version": "2.0.0",
  "description": "Scope-based dependency injection for singleton and prototype objects.",
  "keywords": [
    "di",
    "dependency-injection",
    "ioc",
    "scope",
    "singleton",
    "prototype",
    "typescript",
    "javascript",
    "decorators"
  ],
  "homepage": "https://github.com/Ascentx/neat-di#readme",
  "bugs": {
    "url": "https://github.com/Ascentx/neat-di/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ascentx/neat-di.git"
  },
  "license": "ISC",
  "author": "Amrinder Singh <amsingh@stonewain.com>",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./all": {
      "types": "./dist/all.d.ts",
      "default": "./dist/all.js"
    },
    "./src/all": {
      "types": "./dist/all.d.ts",
      "default": "./dist/all.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "lint:package": "publint && attw --pack . --profile esm-only",
    "prepublishOnly": "npm run clean && npm run build && npm test && npm run lint:package"
  },
  "dependencies": {
    "toposort": "^2.0.2"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/toposort": "^2.0.7",
    "vitest": "^3.2.4",
    "publint": "^0.3.0",
    "@arethetypeswrong/cli": "^0.18.0"
  }
}
